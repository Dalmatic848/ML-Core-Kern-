# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter Notebook
.ipynb_checkpoints/

# Environments (project venv lives one level above the repo, see README)
.env
.venv/
venv/
env/

# Ruff / mypy
.ruff_cache/
.mypy_cache/

# Editors
.vscode/
.idea/

# ML model weights and datasets (large, not versioned)
*.pth
*.pt
*.ckpt
*.bin
/models/*
!/models/.gitkeep
!/models/README.md
/data/

# Experiment outputs — reproducible from experiments/*.yaml, not versioned
/results/
/logs/

# Claude Code: settings.json is checked in (project conventions), local
# per-machine overrides/permission cache are not.
/.claude/settings.local.json
